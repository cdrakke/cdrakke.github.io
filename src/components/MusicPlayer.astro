---
/**
 * The record player. Kept from the old site on purpose: Hip Shop (Rouxls Kaard, Deltarune), looping,
 * with volume/mute/was-playing remembered. Rendered once and persisted across page navigations.
 */
import Icon from "./Icon.astro";
import { site } from "@/data/site";

const { music } = site;
---

<bgm-player
  class="bgm"
  data-src={music.src}
  data-default-volume={music.defaultVolume}
  transition:persist="bgm"
>
  <button class="pp" type="button" data-action="toggle" aria-pressed="false" aria-label={`Play ${music.title}`}>
    <span class="ico-play"><Icon name="play" size={16} /></span>
    <span class="ico-pause"><Icon name="pause" size={16} /></span>
  </button>
  <span class="bars" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i>
  </span>
  <span class="meta">
    <span class="t">BGM · {music.title}</span>
    <span class="s">{music.artist}</span>
  </span>
  <span class="vol" role="group" aria-label="Volume">
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button type="button" class="dot" data-action="volume" data-level={n} aria-label={`Volume ${n} of 5`} />
      ))
    }
  </span>
  <button class="mute" type="button" data-action="mute" aria-pressed="false" aria-label="Mute">
    <span class="ico-vol"><Icon name="volume" size={15} /></span>
    <span class="ico-mute"><Icon name="mute" size={15} /></span>
  </button>
</bgm-player>

<script>
  const KEYS = { volume: "music-volume", muted: "music-muted", playing: "music-was-playing" } as const;

  class BgmPlayer extends HTMLElement {
    audio: HTMLAudioElement | null = null;
    volume = 0.3;
    muted = false;
    playing = false;
    private wired = false;

    static live: BgmPlayer | null = null;

    private onToggle: (() => void) | null = null;
    private onQuery: (() => void) | null = null;
    private onPageLoad: (() => void) | null = null;

    /** Drop the audio and document listeners for good. Used when this instance lost the page. */
    private release() {
      if (this.onToggle) document.removeEventListener("bgm:toggle", this.onToggle);
      if (this.onQuery) document.removeEventListener("bgm:query", this.onQuery);
      if (this.onPageLoad) document.removeEventListener("astro:page-load", this.onPageLoad);
      this.onToggle = this.onQuery = this.onPageLoad = null;
      if (this.audio) {
        this.audio.pause();
        this.audio.src = "";
        this.audio = null;
      }
      this.playing = false;
      if (BgmPlayer.live === this) BgmPlayer.live = null;
    }

    connectedCallback() {
      if (this.wired) return;
      this.wired = true;

      // During a client-side swap the incoming page's <bgm-player> connects for a moment before the
      // persisted one replaces it, so ownership is settled on astro:page-load (below), never here.
      if (!BgmPlayer.live) BgmPlayer.live = this;

      const def = parseFloat(this.dataset.defaultVolume ?? "0.3");
      this.volume = this.read(KEYS.volume, def);
      this.muted = this.readBool(KEYS.muted);

      const audio = new Audio(this.dataset.src ?? "");
      audio.loop = true;
      audio.preload = "metadata";
      this.audio = audio;
      this.applyVolume();

      this.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
        if (!btn) return;
        const action = btn.dataset.action;
        if (action === "toggle") this.toggle();
        else if (action === "mute") this.setMuted(!this.muted);
        else if (action === "volume") this.setVolume(Number(btn.dataset.level) / 5);
      });

      // Outside controls (the record player in the room, keyboard shortcut) ask through events.
      // Handlers are kept so a retired instance can drop them in release().
      this.onToggle = () => this.toggle();
      this.onQuery = () => this.announce();
      this.onPageLoad = () => {
        // transition:persist moves this element between pages (disconnect, reconnect during the swap).
        // Once the new page has loaded, an instance that is not in the document lost its page for good:
        // release its audio and listeners, or an orphan keeps playing under the next page's player.
        if (!this.isConnected) {
          this.release();
          return;
        }
        BgmPlayer.live = this;
        this.announce();
      };
      document.addEventListener("bgm:toggle", this.onToggle);
      document.addEventListener("bgm:query", this.onQuery);
      document.addEventListener("astro:page-load", this.onPageLoad);

      // If music was playing last visit, resume on the first gesture (autoplay policy).
      if (this.readBool(KEYS.playing)) {
        const resume = (e: Event) => {
          cleanup();
          // A first gesture on a play control is handled by that control's own click; resuming here too would cancel it.
          const t = e.target as Element | null;
          if (t?.closest?.('[data-action="toggle"], [data-event="bgm:toggle"], [data-bgm-legend]')) return;
          this.play();
        };
        const cleanup = () => {
          document.removeEventListener("pointerdown", resume);
          document.removeEventListener("keydown", resume);
        };
        document.addEventListener("pointerdown", resume, { once: true });
        document.addEventListener("keydown", resume, { once: true });
      }

      this.render();
      this.announce();
    }

    private read(key: string, fallback: number) {
      try {
        const v = localStorage.getItem(key);
        const n = v === null ? NaN : parseFloat(v);
        return Number.isFinite(n) ? Math.min(1, Math.max(0, n)) : fallback;
      } catch {
        return fallback;
      }
    }

    private readBool(key: string) {
      try {
        return localStorage.getItem(key) === "true";
      } catch {
        return false;
      }
    }

    private write(key: string, value: string) {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* private mode: nothing to remember, nothing lost */
      }
    }

    toggle() {
      if (BgmPlayer.live !== this) return; // a retired instance still hears document events; it stays quiet
      if (this.playing) this.pause();
      else this.play();
    }

    async play() {
      if (!this.audio) return;
      try {
        await this.audio.play();
        this.playing = true;
      } catch {
        this.playing = false;
      }
      this.write(KEYS.playing, String(this.playing));
      this.render();
      this.announce();
    }

    pause() {
      this.audio?.pause();
      this.playing = false;
      this.write(KEYS.playing, "false");
      this.render();
      this.announce();
    }

    setVolume(v: number) {
      this.volume = Math.min(1, Math.max(0, v));
      if (this.volume > 0 && this.muted) this.muted = false;
      this.write(KEYS.volume, String(this.volume));
      this.write(KEYS.muted, String(this.muted));
      this.applyVolume();
      this.render();
    }

    setMuted(m: boolean) {
      this.muted = m;
      this.write(KEYS.muted, String(m));
      this.applyVolume();
      this.render();
      this.announce();
    }

    private applyVolume() {
      if (this.audio) this.audio.volume = this.muted ? 0 : this.volume;
    }

    private announce() {
      if (BgmPlayer.live !== this) return;
      document.dispatchEvent(
        new CustomEvent("bgm:state", {
          detail: { playing: this.playing, muted: this.muted, volume: this.volume },
        }),
      );
    }

    private render() {
      this.toggleAttribute("playing", this.playing);
      this.toggleAttribute("muted", this.muted);
      const pp = this.querySelector<HTMLButtonElement>("[data-action=toggle]");
      if (pp) {
        pp.setAttribute("aria-pressed", String(this.playing));
        pp.setAttribute("aria-label", this.playing ? "Pause Hip Shop" : "Play Hip Shop");
      }
      const mute = this.querySelector<HTMLButtonElement>("[data-action=mute]");
      if (mute) {
        mute.setAttribute("aria-pressed", String(this.muted));
        mute.setAttribute("aria-label", this.muted ? "Unmute" : "Mute");
      }
      const level = this.muted ? 0 : Math.round(this.volume * 5);
      this.querySelectorAll<HTMLButtonElement>("[data-action=volume]").forEach((d) => {
        d.classList.toggle("on", Number(d.dataset.level) <= level);
      });
    }
  }

  if (!customElements.get("bgm-player")) customElements.define("bgm-player", BgmPlayer);
</script>

<style>
  .bgm {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--field);
    border: var(--border);
    border-radius: var(--radius-pill);
    padding: 5px 12px 5px 6px;
    font-size: var(--text-sm);
    font-weight: 800;
    box-shadow: var(--lift);
    min-height: 44px;
  }

  .pp {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    border: 1.8px solid var(--line);
    display: grid;
    place-items: center;
    padding: 0;
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .pp:active {
    transform: scale(0.94);
  }
  .pp > span {
    display: grid;
    place-items: center;
  }
  .pp > .ico-pause,
  .bgm[playing] .pp > .ico-play {
    display: none;
  }
  .bgm[playing] .pp > .ico-pause {
    display: grid;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 16px;
  }
  .bars i {
    width: 4px;
    height: 4px;
    background: var(--ink);
    border-radius: var(--radius-hairline);
    display: block;
    opacity: 0.8;
    transform-origin: bottom;
  }
  .bgm[playing] .bars i {
    animation: levels 900ms var(--ease-out) infinite alternate;
  }
  .bgm[playing] .bars i:nth-child(1) {
    animation-delay: 0ms;
  }
  .bgm[playing] .bars i:nth-child(2) {
    animation-delay: 140ms;
  }
  .bgm[playing] .bars i:nth-child(3) {
    animation-delay: 280ms;
  }
  .bgm[playing] .bars i:nth-child(4) {
    animation-delay: 90ms;
  }
  .bgm[playing] .bars i:nth-child(5) {
    animation-delay: 220ms;
  }
  @keyframes levels {
    from {
      height: 4px;
    }
    to {
      height: 16px;
    }
  }

  .meta {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .t {
    font-family: var(--font-display-stack);
    font-weight: 500;
    font-size: var(--text-md);
    white-space: nowrap;
  }
  .s {
    color: var(--ink-soft);
    font-size: var(--text-xs);
  }

  .vol {
    display: flex;
    gap: 3px;
    margin-left: 4px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.4px solid var(--line);
    background: var(--white);
    padding: 0;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .dot.on {
    background: var(--butter);
  }

  .mute {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.4px solid var(--line);
    background: var(--white);
    display: grid;
    place-items: center;
    padding: 0;
    flex: none;
  }
  .mute > span {
    display: grid;
    place-items: center;
  }
  .mute > .ico-mute,
  .bgm[muted] .mute > .ico-vol {
    display: none;
  }
  .bgm[muted] .mute > .ico-mute {
    display: grid;
  }

  /* The nav carries five tabs; below this the player gives up its title and volume dots to make room for them. */
  @media (max-width: 1040px) {
    .meta,
    .vol {
      display: none;
    }
    .bgm {
      padding-right: 6px;
    }
  }

  @media (max-width: 400px) {
    .bars {
      display: none;
    }
    .bgm {
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bgm[playing] .bars i {
      animation: none;
      height: 10px;
    }
  }
</style>
