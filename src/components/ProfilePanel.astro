---
/** Who lives here. Portrait sticker, name, one true sentence, real counters, the three actions in priority order. */
import { Image } from "astro:assets";
import Panel from "./Panel.astro";
import StickerButton from "./StickerButton.astro";
import Icon from "./Icon.astro";
import { site } from "@/data/site";
import { copy } from "@/data/copy";
import avatar from "@/assets/images/avatar.png";

interface Props {
  projectCount: number;
  /** Sum of the two flagship commit counts, rounded down to the hundred, e.g. "1,600+". */
  flagshipCommits: string;
  guilds: string;
  i?: number;
}

const { projectCount, flagshipCommits, guilds, i } = Astro.props;
---

<Panel title="Profile" icon="home" tone="sky" class="profile" id="profile" i={i}>
  <div class="portrait">
    <Image src={avatar} alt={`${site.name}, studio portrait in a barong`} width={280} height={280} densities={[1, 2]} loading="eager" />
    <span class="tape" aria-hidden="true"></span>
  </div>
  <h1 class="name">
    {site.handle}
    <small>{site.name}<br />{site.role}</small>
  </h1>
  <p class="loc"><i aria-hidden="true"></i>{site.locationShort} · Remote</p>

  <div class="note">
    <b>today's note</b>
    <p>{copy.oneTrueSentence}</p>
  </div>

  <dl class="counters">
    <div class="ct"><dt>Projects</dt><dd>{projectCount}</dd></div>
    <div class="ct"><dt>Commits on flagships</dt><dd>{flagshipCommits}</dd></div>
    <div class="ct"><dt>Guilds served</dt><dd>{guilds}</dd></div>
    <div class="ct mood"><dt>Mood</dt><dd><Icon name="spark" size={16} class="spark" />shipping</dd></div>
  </dl>

  <div class="btns">
    <StickerButton href="/diary" tone="mint" icon="door" kicker={`${projectCount} entries`}>Visit my work</StickerButton>
    <StickerButton href={`mailto:${site.email}`} tone="sky" icon="mail">Leave a note (email)</StickerButton>
    <StickerButton href={site.resumePath} tone="butter" icon="pdf" download="Calvin_Drakke_Rulete_Resume.pdf">Take my resume (PDF)</StickerButton>
  </div>
</Panel>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .portrait {
    position: relative;
    width: 140px;
    height: 140px;
    margin-top: var(--space-3);
    transform: rotate(-3deg);
  }
  .portrait :global(img) {
    width: 140px;
    height: 140px;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-xl);
    border: 6px solid var(--white);
    box-shadow: var(--shadow-photo);
    display: block;
  }
  .tape {
    position: absolute;
    left: 38px;
    top: -11px;
    width: 62px;
    height: 18px;
    background: rgba(247, 213, 139, 0.85);
    border: 1px solid rgba(58, 46, 63, 0.25);
    transform: rotate(4deg);
    border-radius: var(--radius-hairline);
    box-shadow: 0 1px 2px rgba(58, 46, 63, 0.1);
  }
  .tape::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-top: 1px dashed rgba(58, 46, 63, 0.25);
    border-bottom: 1px dashed rgba(58, 46, 63, 0.25);
  }

  .name {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    margin-top: var(--space-4);
    letter-spacing: 0.5px;
  }
  .name small {
    display: block;
    font-family: var(--font-body-stack);
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1.3;
    letter-spacing: 0;
    margin-top: 6px;
  }
  .loc {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-soft);
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .loc i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    border: 1px solid var(--line);
    display: inline-block;
  }

  .note {
    position: relative;
    margin-top: var(--space-4);
    background: var(--blush);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: 16px 12px 11px;
    font-size: var(--text-sm);
    line-height: 1.42;
    text-align: left;
    width: 100%;
  }
  .note b {
    position: absolute;
    top: -10px;
    left: 10px;
    background: var(--white);
    border: 1.4px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 2px 9px;
    font-size: var(--text-2xs);
    font-weight: 900;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .counters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    margin: var(--space-3) 0 0;
  }
  .ct {
    background: var(--white);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    padding: 6px 8px;
    text-align: left;
    box-shadow: var(--lift-sm);
  }
  .ct dt {
    font-size: var(--text-2xs);
    font-weight: 900;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ct dd {
    margin: 1px 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.15;
  }
  .ct.mood {
    background: var(--mint);
  }
  .ct.mood :global(.spark) {
    color: var(--butter);
  }

  .btns {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    margin-top: var(--space-3);
  }
</style>
