---
/** The room's floating tab bar. Tabs are stickers; the record player rides at the right end. */
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import MusicPlayer from "./MusicPlayer.astro";
import { site } from "@/data/site";

interface Props {
  counts?: Partial<Record<string, number>>;
}

const { counts = {} } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav class="nav" aria-label="Rooms">
  <ul class="tabs">
    {
      site.nav.map((item) => (
        <li>
          <a class:list={["tab", isActive(item.href) && "on"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            <Icon name={item.icon as IconName} size={18} />
            <span class="lbl">{item.label}</span>
            {counts[item.label] !== undefined && <span class="n">{counts[item.label]}</span>}
          </a>
        </li>
      ))
    }
  </ul>
  <MusicPlayer />
</nav>

<style>
  .nav {
    position: fixed;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 40;
    width: min(calc(100% - 2 * var(--frame-pad)), 1396px);
    height: var(--nav-height);
    background: var(--veil-strong);
    backdrop-filter: blur(6px);
    border: var(--border);
    border-radius: var(--radius-pill);
    box-shadow:
      var(--lift-lg),
      var(--shadow-soft);
    display: flex;
    align-items: center;
    padding: 6px 8px;
    gap: 6px;
  }

  .tabs {
    display: flex;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    padding: 7px 16px;
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--ink);
    text-decoration: none;
    position: relative;
    transition:
      background var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .tab:hover {
    background: var(--field);
  }

  .tab.on {
    background: var(--mint);
    border-color: var(--line);
    box-shadow: var(--lift);
  }

  .tab.on::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 16px;
    height: 3px;
    background: var(--ink);
    border-radius: var(--radius-hairline);
    transform: translateX(-50%);
    opacity: 0.7;
  }

  .n {
    font-family: var(--font-body-stack);
    font-size: var(--text-xs);
    font-weight: 900;
    background: var(--white);
    border: 1.4px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0 6px;
  }

  @media (max-width: 720px) {
    .nav {
      width: calc(100% - 20px);
      height: 58px;
      padding: 5px 6px;
    }
    .tab {
      padding: 6px 10px;
      gap: 5px;
      font-size: var(--text-sm);
    }
    .n {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .lbl {
      display: none;
    }
    .tab {
      padding: 8px 10px;
    }
  }
</style>
