---
import Base from "@/layouts/Base.astro";
import Panel from "@/components/Panel.astro";
import StickerButton from "@/components/StickerButton.astro";
import { site } from "@/data/site";
---

<Base title="Room not found" noindex>
  <div class="wrap">
    <Panel title="Hm" icon="warn" tone="peach" id="lost" i={0} class="lost">
      <svg class="door" viewBox="0 0 120 120" aria-hidden="true">
        <rect x="30" y="18" width="60" height="90" rx="6" fill="#FFF8F1" stroke="#3A2E3F" stroke-width="2.4" stroke-linejoin="round" />
        <rect x="38" y="26" width="44" height="74" rx="4" fill="#E9EFF5" stroke="#3A2E3F" stroke-opacity=".4" stroke-width="1.4" />
        <circle cx="74" cy="66" r="3.5" fill="#3A2E3F" />
        <path d="M22 108h76" stroke="#3A2E3F" stroke-width="2.4" stroke-linecap="round" />
        <path d="M60 8l6 6h-12z" fill="#F7D58B" stroke="#3A2E3F" stroke-width="1.6" stroke-linejoin="round" />
      </svg>
      <h1>This room doesn't exist.</h1>
      <p>The door's painted on. Nothing behind it but wallpaper. Try one of the real rooms instead.</p>
      <div class="btns">
        <StickerButton href="/" tone="mint" icon="home" full={false}>Back to {site.handle}'s room</StickerButton>
        <StickerButton href="/diary" tone="butter" icon="book" full={false}>See my work</StickerButton>
      </div>
    </Panel>
  </div>
</Base>

<style>
  .wrap {
    max-width: 560px;
    margin: var(--space-7) auto;
  }
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding-top: var(--space-6);
  }
  .door {
    width: 120px;
    height: 120px;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  p {
    color: var(--ink-2);
    max-width: 40ch;
  }
  .btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }
</style>
